{
  "name": "masters-flying-school",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "serve .output/public -l 4200 --no-clipboard",
    "port": "node scripts/port-legacy.mjs",
    "og": "node scripts/og-images.mjs",
    "test": "vitest run",
    "test:e2e": "nuxt generate && playwright test --project=nuxt",
    "test:baseline": "playwright test --project=legacy --update-snapshots",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "gsap": "^3.15.0",
    "nuxt": "~4.4.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.6.1",
    "oxc-parser": "^0.133.0",
    "postcss": "^8.5.29",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "compression": "^1.8.2",
    "esbuild": "^0.28.2",
    "simple-git": "^4.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
