# Read by `nuxt generate`. On Vercel, set these under Project Settings > Environment Variables.

# Domain used in canonical URLs, sharing tags, structured data and the sitemap.
NUXT_PUBLIC_SITE_URL=https://mastersflyingschool.com

# false keeps every page out of search results (pitch builds). Set to true only for the school's live site.
NUXT_PUBLIC_INDEXABLE=false

# Web3Forms access key. Defaults to the one in nuxt.config.ts; set this only to swap in another
# (for example the school's own). An empty value falls back to opening the visitor's email app.
# In the Web3Forms dashboard, turn on hCaptcha so submissions without a solved check are rejected.
# NUXT_PUBLIC_WEB3FORMS_KEY=
